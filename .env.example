# Copia questo file in .env.local e compila i valori.
# Sono valori PUBBLICI per progettazione (finiscono nel bundle): la sicurezza sta nella RLS.
# NON inserire mai qui la service_role / secret key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SOLO per lo script di import dello Sheet (npm run import:sheet), in .env.local sul tuo PC.
# È la chiave che salta la RLS: non metterla mai in una variabile VITE_*, nel repo o in GitHub.
# SUPABASE_SERVICE_ROLE_KEY=
