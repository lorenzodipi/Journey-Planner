{
  "name": "journey-planner",
  "private": true,
  "version": "0.1.0",
  "description": "Planner di viaggio personale, mobile-first, editabile dal telefono",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sql": "node supabase/tests/rls.test.mjs",
    "import:sheet": "node --env-file-if-exists=.env.local scripts/import-sheet/import.mjs",
    "import:kmz": "node --env-file-if-exists=.env.local scripts/import-kmz/import.mjs",
    "build:native": "tsc --noEmit && vite build --mode native --outDir dist-native --emptyOutDir",
    "assets:native": "capacitor-assets generate --iconBackgroundColor \"#20407b\" --splashBackgroundColor \"#0b1b33\""
  },
  "dependencies": {
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.14.0",
    "preact": "^11.0.1",
    "suncalc": "^2.1.1",
    "wouter-preact": "^3.13.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@electric-sql/pglite": "^0.5.10",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "read-excel-file": "^9.3.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
